{
  "name": "leen-life-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Leen Life Operations Platform — GashtySoft (Gashty Limited HK) for Merna Medical Company. Phase 1 branch: Leen Life Medical Complex, Erbil.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @leen-life/api --filter @leen-life/database --filter @leen-life/permissions test",
    "db:migrate": "pnpm --filter @leen-life/database migrate:dev",
    "db:deploy": "pnpm --filter @leen-life/database migrate:deploy",
    "db:seed": "pnpm --filter @leen-life/database seed",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "bcrypt",
      "sharp",
      "unrs-resolver"
    ]
  }
}
