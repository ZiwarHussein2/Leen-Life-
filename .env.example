# ============================================================
# Leen Life Operations Platform — environment configuration
# Copy to .env and fill in real values. NEVER commit real secrets.
# ============================================================

# --- Core ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
API_PORT=3001

# --- Database (PostgreSQL, main application database) ---
DATABASE_URL=postgresql://leenlife:leenlife_dev_password@localhost:5432/leenlife?schema=public

# --- Supabase (authentication ONLY — not the main database) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Development-only fallback: when AUTH_DEV_MODE=true the API accepts
# HS256 tokens signed with AUTH_DEV_JWT_SECRET (for local/E2E testing
# without a live Supabase project). MUST be false in production.
AUTH_DEV_MODE=true
AUTH_DEV_JWT_SECRET=local-dev-secret-change-me

# --- Email (Resend) ---
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Leen Life <no-reply@leenlife.gashtysoft.com>"
# When EMAIL_DEV_MODE=true, emails are logged/stored, not sent.
EMAIL_DEV_MODE=true

# --- Telegram notifications (report doctors, admin alerts) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# When TELEGRAM_DEV_MODE=true, messages are logged/stored, not sent.
TELEGRAM_DEV_MODE=true

# --- Redis (BullMQ background jobs) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible, private; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=leenlife-minio
S3_SECRET_KEY=leenlife-minio-secret
S3_BUCKET_SCANS=leenlife-scans
S3_BUCKET_DOCUMENTS=leenlife-documents
S3_FORCE_PATH_STYLE=true

# --- File lifecycle / security ---
FILE_MAX_UPLOAD_MB=2048
FILE_RETENTION_DAYS=7
SIGNED_URL_EXPIRY_SECONDS=900
ZIP_MAX_ENTRIES=10000
ZIP_MAX_DECOMPRESSED_MB=8192

# --- Attendance geofence (Leen Life Medical Complex, Erbil) ---
GEOFENCE_LAT=36.1901
GEOFENCE_LNG=44.0091
GEOFENCE_RADIUS_METERS=150

# --- Security ---
SESSION_TIMEOUT_MINUTES=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
QR_VERIFICATION_BASE_URL=http://localhost:3000/verify

# --- Merna connector (future central platform; disabled by default) ---
MERNA_CONNECTOR_ENABLED=false
MERNA_CONNECTOR_SERVICE_KEY=
